{
  "name": "@mediawiki-typescript/api",
  "version": "0.0.0",
  "description": "A typed client for the MediaWiki Action API and REST API, targeting the OSRS Wiki.",
  "license": "GPL-3.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "jest",
    "codegen": "tsx codegen/generate.ts"
  },
  "dependencies": {
    "@mediawiki-typescript/builder": "0.0.0",
    "@mediawiki-typescript/parser": "0.0.0",
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.3",
    "oauth-1.0a": "^2.2.6",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/tough-cookie": "^4.0.5",
    "jest": "^30.4.2",
    "nock": "^14.0.1",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
