exports[`SwitchParserFunction it should render with a trailing bare default 1`] = `
"{{#switch:baz|foo=Foo|baz=Baz|Bar}}
"
`;

exports[`SwitchParserFunction it should render with an explicit #default case 1`] = `
"{{#switch:test|foo=Foo|#default=Bar|baz=Baz}}
"
`;

exports[`SwitchParserFunction it should render with cases and a default 1`] = `
"{{#switch:{{#var:weekly}}|0=LMS Competitive|1=}}
"
`;

exports[`SwitchParserFunction it should render with fallthrough cases sharing a result 1`] = `
